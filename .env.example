# Core
PORT=3000
NODE_ENV=production
BASE_URL=https://your-domain.com
ADMIN_EMAIL=you@example.com
FORCE_HTTPS=1

# Storage
DATA_DIR=./data
STORAGE_DIR=./storage
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=200

# Email (optional)
SMTP_URL=
MAIL_FROM=QRNova <hello@example.com>

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Security
CORS_ORIGINS=
CSP=
METRICS_TOKEN=

# Backups and logs
BACKUP_HOURS=24
BACKUP_KEEP=14
LOG_DAYS=14

# Docker / Caddy
DOMAIN=your-domain.com